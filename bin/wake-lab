#!/usr/bin/env bash

set -euo pipefail

PROGRAM="${0##*/}"
CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/unix-tools/wake-lab.conf"

usage() {
  cat <<EOF
Usage: ${PROGRAM} [--help] <all | host [host ...]>

Wake up homelab computers using Wake-on-LAN.

Arguments:
  all              Wake up all configured hosts
  host [host ...]  Wake up one or more selected hosts

Options:
  -h, --help       Show this help message

Available hosts:
EOF

  if declare -p HOMELAB &>/dev/null; then
    if (( ${#HOMELAB[@]} > 0 )); then
      printf '  %s\n' "${!HOMELAB[@]}" | sort
    else
      printf '  (no hosts configured)\n'
    fi
  else
    printf '  (not configured)\n'
  fi

  cat <<EOF

Examples:
  ${PROGRAM} all
  ${PROGRAM} HOST1
  ${PROGRAM} HOST1 HOST2
EOF
}

error() {
  printf 'Error: %s\n' "$1" >&2
}

wake_host() {
  local host="$1"

  printf 'Waking up %-12s [%s]\n' \
    "$host" "${HOMELAB[$host]}"

  wakeonlan "${HOMELAB[$host]}"
}

main() {
  local host
  local -a hosts=()

  # Load configuration if available
  if [[ -r "$CONFIG_FILE" ]]; then
    # Configuration is trusted local Bash code.
    source "$CONFIG_FILE"
  fi

  # Handle help before requiring configuration
  if (( $# == 0 )); then
    usage >&2
    return 2
  fi

  case "$1" in
    -h|--help)
      usage
      return 0
      ;;
  esac

  # Configuration is mandatory for operational commands
  if [[ ! -r "$CONFIG_FILE" ]]; then
    error "configuration not found: $CONFIG_FILE"
    return 1
  fi

  if ! declare -p HOMELAB 2>/dev/null |
       grep -q '^declare -A '; then
    error "HOMELAB associative array is not defined"
    return 1
  fi

  # Resolve requested hosts
  case "$1" in
    all)
      if (( $# != 1 )); then
        error "'all' cannot be combined with other hosts"
        return 2
      fi

      hosts=("${!HOMELAB[@]}")
      ;;
    *)
      hosts=("$@")
      ;;
  esac

  # Validate all hosts before sending packets
  for host in "${hosts[@]}"; do
    if [[ ! -v HOMELAB[$host] ]]; then
      error "unknown host: $host"
      return 2
    fi
  done

  # Check dependency
  if ! command -v wakeonlan >/dev/null 2>&1; then
    error "wakeonlan is not installed"
    return 1
  fi

  for host in "${hosts[@]}"; do
    wake_host "$host"
  done
}

main "$@"
